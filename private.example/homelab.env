# Copy to private/homelab.env (gitignored) and fill in. install.sh does the copy.
TAILNET_HOST="my-server.tailXXXXXX.ts.net"    # `tailscale status --json` → Self.DNSName
HOMELAB_HOST="my-server"                      # SSH alias for the server
HOMEPAGE_URL="http://my-server.tailXXXXXX.ts.net:3000"
WUD_URL="http://my-server.tailXXXXXX.ts.net:3010"
WUD_USER="admin"
WUD_PASSWORD="(from the server stack .env)"
