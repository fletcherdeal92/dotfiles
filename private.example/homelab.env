# Copy to private/homelab.env (gitignored) and fill in. install.sh does the copy.
HOMELAB_HOST="192.168.1.10"                 # SSH host / VM address
HOMEPAGE_URL="http://192.168.1.10:3000"
HOME_ROUTER="192.168.1.1"                   # `ipconfig getpacket en0 | grep router`
HOME_DOMAIN="home.arpa"                     # `ipconfig getpacket en0 | grep domain_name`
