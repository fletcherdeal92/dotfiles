# Copy to private/homelab.env (gitignored) and fill in. install.sh does the copy.
TAILNET_HOST="my-server.tailXXXXXX.ts.net"    # `tailscale status --json` → Self.DNSName
HOMELAB_HOST="my-server"                      # SSH alias for the server
HOMEPAGE_URL="http://my-server.tailXXXXXX.ts.net:3000"     # dashboard (sketchybar homelab dot)
STARTPAGE_URL="http://my-server.tailXXXXXX.ts.net:8083"    # Glance — Zen homepage/new tab
WUD_URL="http://my-server.tailXXXXXX.ts.net:3010"
WUD_USER="admin"
WUD_PASSWORD="(from the server stack .env)"
MINIFLUX_URL="http://my-server.tailXXXXXX.ts.net:8081"
MINIFLUX_API_KEY="(Miniflux → Settings → API Keys)"    # config/miniflux/deploy.sh
