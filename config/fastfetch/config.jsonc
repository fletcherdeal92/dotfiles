// fastfetch — Severance palette (sage #8C9F82, muted #4C566A, fg #C5C8C6)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "macOS",
    "color": {
      "1": "38;2;140;159;130", "2": "38;2;140;159;130", "3": "38;2;140;159;130",
      "4": "38;2;140;159;130", "5": "38;2;140;159;130", "6": "38;2;140;159;130"
    },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;140;159;130", "title": "38;2;140;159;130", "output": "38;2;197;200;198" },
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─", "outputColor": "38;2;76;86;106" },
    { "type": "os",           "key": " os" },
    { "type": "host",         "key": " host" },
    { "type": "kernel",       "key": " kernel" },
    { "type": "uptime",       "key": " uptime" },
    { "type": "packages",     "key": " pkgs" },
    { "type": "shell",        "key": " shell" },
    { "type": "command",      "key": "\uf2d2 wm", "text": "/opt/homebrew/bin/hyprspace --version | head -1" },
    { "type": "terminal",     "key": " term" },
    { "type": "terminalfont", "key": " font" },
    { "type": "cpu",          "key": " cpu" },
    { "type": "memory",       "key": " memory" },
    { "type": "disk",         "key": "\uf0a0 disk", "folders": "/System/Volumes/Data", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",      "key": " battery" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
