// fastfetch on lin-server — Severance palette, matches the Mac's config.
// Lives in dotfiles/server/fastfetch; deployed by server/deploy.sh to ~/.config/fastfetch.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;140;159;130", "2": "38;2;76;86;106", "3": "38;2;197;200;198" },
    "padding": { "top": 0, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;140;159;130", "title": "38;2;140;159;130", "output": "38;2;197;200;198" },
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─", "outputColor": "38;2;76;86;106" },
    { "type": "os",      "key": " os", "format": "{name} {version-id}" },
    { "type": "kernel",  "key": " kernel" },
    { "type": "uptime",  "key": " uptime" },
    { "type": "memory",  "key": " memory" },
    { "type": "disk",    "key": " disk", "folders": "/", "format": "{size-free} free of {size-total} ({size-percentage} used)" },
    { "type": "command", "key": " media",      "text": "$HOME/.config/fastfetch/bin/media.sh" },
    { "type": "command", "key": " containers", "text": "$HOME/.config/fastfetch/bin/containers.sh" },
    { "type": "command", "key": "\udb82\udc68 updates", "text": "$HOME/.config/fastfetch/bin/wud.sh" },
    { "type": "command", "key": "\udb81\udd82 tailnet", "text": "$HOME/.config/fastfetch/bin/tailscale.sh" }
  ]
}
